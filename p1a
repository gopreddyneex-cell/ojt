from collections import deque

def water_jug_bfs(jug1, jug2, target):

    # Initial state
    start = (0, 0)

    # Queue for BFS
    queue = deque([(start, [])])

    # Visited states
    visited = set([start])

    while queue:
        (a, b), path = queue.popleft()

        # Check goal
        if a == target or b == target:
            print("Solution:")
            for state in path + [(a, b)]:
                print(state)
            return

        # Generate possible states
        states = [
            (jug1, b),                    
            (a, jug2),                    
            (0, b),                       
            (a, 0),                       
            (a - min(a, jug2 - b),
             b + min(a, jug2 - b)),      
            (a + min(b, jug1 - a),
             b - min(b, jug1 - a))       
        ]

        # Add new states to queue
        for new_state in states:
            if new_state not in visited:
                visited.add(new_state)
                queue.append(
                    (new_state, path + [(a, b)])
                )


# 4-litre jug, 3-litre jug, target = 2 litres
water_jug_bfs(4, 3, 2)
